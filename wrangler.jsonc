// Cloudflare Workers (statische Assets). Build: python build.py + Kopie nach dist/ (siehe README).
// "name" muss dem Worker-Namen im Cloudflare-Dashboard entsprechen.
{
  "name": "stolz-consulting",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
